# Path to Google OAuth desktop client JSON (never commit the file itself).
# See docs/SETUP.md for GCP + OAuth walkthrough.
TAGSMITH_GOOGLE_CLIENT_SECRET_PATH=~/.config/tagsmith/credentials.json

# Pydantic AI model string. Examples:
#   openai:gpt-4.1-mini
#   google-gla:gemini-2.0-flash
#   ollama:llama3.1
#   openrouter:deepseek/deepseek-v4-flash-0731
# Switching providers is an env-var change, never a code change.
TAGSMITH_LLM_MODEL=openrouter:deepseek/deepseek-v4-flash-0731

# Provider API key — must match the provider prefix in TAGSMITH_LLM_MODEL.
# These are loaded from .env into the process env for Pydantic AI.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Confidence routing
TAGSMITH_CONFIDENCE_APPLY=0.75
TAGSMITH_CONFIDENCE_REVIEW=0.5

# Optional overrides
# TAGSMITH_DATABASE_URL=sqlite:////absolute/path/to/tagsmith.db
# TAGSMITH_LABEL_PARENT=AI
# TAGSMITH_BODY_CHAR_LIMIT=2000
# TAGSMITH_LOG_LEVEL=INFO
