# Path to Google OAuth desktop client JSON (never commit the file itself).
# See docs/SETUP.md for GCP + OAuth walkthrough.
TAGSMITH_GOOGLE_CLIENT_SECRET_PATH=~/.config/tagsmith/credentials.json

# Pydantic AI model string. Examples:
#   openai:gpt-4.1-mini
#   google-gla:gemini-2.0-flash
#   ollama:llama3.1
#   openrouter:deepseek/deepseek-v4-flash-0731
# Switching providers is an env-var change, never a code change.
TAGSMITH_LLM_MODEL=openrouter:deepseek/deepseek-v4-flash-0731

# Provider API key — must match the provider prefix in TAGSMITH_LLM_MODEL.
# These are loaded from .env into the process env for Pydantic AI.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Confidence routing
TAGSMITH_CONFIDENCE_APPLY=0.75
TAGSMITH_CONFIDENCE_REVIEW=0.5

# Phase 2 observability / eval cost estimates (optional)
# TAGSMITH_ENABLE_LOGFIRE=true
# LOGFIRE_TOKEN=
# TAGSMITH_COST_PER_1K_INPUT_TOKENS=0.15
# TAGSMITH_COST_PER_1K_OUTPUT_TOKENS=0.60

# Optional overrides
# TAGSMITH_DATABASE_URL=sqlite:////absolute/path/to/tagsmith.db
# TAGSMITH_LABEL_PARENT=AI
# TAGSMITH_BODY_CHAR_LIMIT=2000
# TAGSMITH_LOG_LEVEL=INFO
# TAGSMITH_LLM_OUTPUT_RETRIES=3

# Phase 3 RAG (few-shot retrieval)
# TAGSMITH_ENABLE_RAG=true
# TAGSMITH_RAG_EXAMPLE_K=5
# TAGSMITH_RAG_CATEGORY_K=3
# TAGSMITH_RAG_EMBEDDING_DIM=256

# Phase 4 — continuous sync / Pub/Sub watch
# TAGSMITH_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/tagsmith-gmail
# TAGSMITH_SCHEDULE_INTERVAL_SECONDS=300
# TAGSMITH_WATCH_RENEW_HOURS=144
# Background loop inside `tagsmith api` (sync + RAG catch-up). Default on.
# TAGSMITH_ENABLE_BACKGROUND_SYNC=true
# Write Gmail labels from that loop (default dry-run, same as `schedule run`).
# TAGSMITH_BACKGROUND_SYNC_APPLY=false

# Phase 5 — API / dashboard / tenants
# TAGSMITH_API_HOST=127.0.0.1
# TAGSMITH_API_PORT=8080
# TAGSMITH_API_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Dashboard URL (OAuth redirects here after login; use :3001 if that port is busy)
# TAGSMITH_WEB_APP_URL=http://127.0.0.1:3000
# TAGSMITH_TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret
# TAGSMITH_GOOGLE_WEB_CLIENT_ID=
# TAGSMITH_GOOGLE_WEB_CLIENT_SECRET=
# TAGSMITH_DATABASE_URL=postgresql+psycopg://tagsmith:tagsmith@localhost:5432/tagsmith
# TAGSMITH_STRIPE_API_KEY=
# TAGSMITH_STRIPE_WEBHOOK_SECRET=
